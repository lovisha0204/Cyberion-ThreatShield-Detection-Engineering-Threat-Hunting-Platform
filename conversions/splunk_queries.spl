// ==============================================================================
// CYBERION DEFENSE LABS - BACKEND PORTABILITY: SPLUNK SPL CONVERSIONS
// Reference: Sigma Rule Library (CDL-DET-V2)
// Generated for: Splunk Enterprise / Splunk Enterprise Security (ES)
// ==============================================================================

// ------------------------------------------------------------------------------
// CDL-RULE-001: Suspicious PowerShell Download Cradle (T1059.001)
// ------------------------------------------------------------------------------
index=windows sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1
(Image="*\\powershell.exe" OR Image="*\\pwsh.exe")
(CommandLine="*Net.WebClient*" OR CommandLine="*DownloadString*" OR CommandLine="*DownloadFile*" OR CommandLine="*Invoke-WebRequest*" OR CommandLine="*iwr *" OR CommandLine="*irm *" OR CommandLine="*curl.exe*")
(CommandLine="*IEX*" OR CommandLine="*Invoke-Expression*" OR CommandLine="*[ScriptBlock]::Create*")
NOT (CommandLine="*C:\\Program Files\\NinjaRMM\\*" OR CommandLine="*C:\\Program Files (x86)\\Kaseya\\*")
| table _time, host, user, Image, CommandLine, ParentImage

// ------------------------------------------------------------------------------
// CDL-RULE-002: LSASS Memory Access for Credential Dumping (T1003.001)
// ------------------------------------------------------------------------------
index=windows sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=10
TargetImage="*\\lsass.exe"
(GrantedAccess="*0x1010*" OR GrantedAccess="*0x1FFFFF*" OR GrantedAccess="*0x1410*" OR GrantedAccess="*0x1438*")
NOT (SourceImage="*\\MsSense.exe" OR SourceImage="*\\svchost.exe" OR SourceImage="*\\csrss.exe" OR SourceImage="*\\wmiprvse.exe")
| table _time, host, SourceImage, TargetImage, GrantedAccess, CallTrace

// ------------------------------------------------------------------------------
// CDL-RULE-003: PsExec Service Installation for Remote Execution (T1569.002, T1021.002)
// ------------------------------------------------------------------------------
index=windows sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1
(Image="*\\PSEXESVC.exe" OR Image="*\\psexec.exe") OR (ParentImage="*\\services.exe" AND (CommandLine="*PSEXESVC*" OR CommandLine="*-accepteula*"))
| table _time, host, user, Image, CommandLine, ParentImage

// ------------------------------------------------------------------------------
// CDL-RULE-004: WMI Remote Process Creation (T1047)
// ------------------------------------------------------------------------------
index=windows sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1
((ParentImage="*\\wmiprvse.exe" AND (Image="*\\cmd.exe" OR Image="*\\powershell.exe" OR Image="*\\pwsh.exe" OR Image="*\\rundll32.exe" OR Image="*\\mshta.exe" OR Image="*\\cscript.exe" OR Image="*\\wscript.exe" OR Image="*\\certutil.exe"))
OR (Image="*\\wmic.exe" AND (CommandLine="*process call create*" OR CommandLine="*process create*")))
| table _time, host, user, Image, CommandLine, ParentImage

// ------------------------------------------------------------------------------
// CDL-RULE-005: Suspicious C2 Beaconing via HTTP (T1071.001)
// ------------------------------------------------------------------------------
index=zeek sourcetype="zeek:http"
(uri="*/api/v1/heartbeat*" OR uri="*/match/submit.php*" OR uri="*/news/update.php*" OR uri="*/push.php*" OR uri="*/beacon.txt*")
OR ((user_agent="*Mozilla/4.0 (compatible; MSIE 6.0; Windows NT 5.1)*" OR user_agent="*Cobalt*" OR user_agent="*Sliver*" OR user_agent="*curl/*" OR user_agent="*Python-urllib*")
AND (id_resp_p=8080 OR id_resp_p=8443 OR id_resp_p=8888 OR id_resp_p=7001))
| table _time, id_orig_h, id_resp_h, id_resp_p, uri, user_agent, status_code

// ------------------------------------------------------------------------------
// CDL-RULE-006: Active Directory Database Extraction via Volume Shadow Copy (T1003.003)
// ------------------------------------------------------------------------------
index=windows sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1
((Image="*\\vssadmin.exe" AND (CommandLine="*create shadow*" OR CommandLine="*delete shadows*"))
OR (Image="*\\ntdsutil.exe" AND (CommandLine="*ntds*" OR CommandLine="*ifm*" OR CommandLine="*ac i ntds*"))
OR (Image="*\\esentutl.exe" AND CommandLine="*ntds.dit*"))
| table _time, host, user, Image, CommandLine, ParentImage

// ------------------------------------------------------------------------------
// CDL-RULE-007: Account Added to Privileged Domain Security Group (T1098, T1078.002)
// ------------------------------------------------------------------------------
index=windows sourcetype="XmlWinEventLog:Security" (EventCode=4728 OR EventCode=4732 OR EventCode=4756)
(TargetUserName="*Domain Admins*" OR TargetUserName="*Enterprise Admins*" OR TargetUserName="*Schema Admins*" OR TargetUserName="*Administrators*")
| table _time, host, SubjectUserName, TargetUserName, MemberName

// ------------------------------------------------------------------------------
// CDL-RULE-016: Correlation - Brute Force Followed by Successful Logon (T1110 -> T1078)
// ------------------------------------------------------------------------------
index=windows sourcetype="XmlWinEventLog:Security" (EventCode=4625 OR EventCode=4624)
| eval Status=if(EventCode=4625, "Failure", "Success")
| bin _time span=5m
| stats count(eval(Status="Failure")) as Failures, count(eval(Status="Success")) as Successes, values(TargetUserName) as Users by _time, IpAddress
| where Failures >= 5 AND Successes >= 1
